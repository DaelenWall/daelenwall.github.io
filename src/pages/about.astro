---
import Shell from '../layouts/Shell.astro';
import about from '../data/about.md?raw';
import { home, url } from '../lib/content';
import { renderMarkdown } from '../../shared/markdown.mjs';
---
<Shell title="About"><header class="page-heading"><div class="eyebrow"><span class="signal"></span>Daelen Wall</div><h1>About<span class="accent">.</span></h1><span class="heading-mark" aria-hidden="true">✳</span></header>{about.trim() || home.portrait ? <div class="about-layout">{home.portrait && <img class:list={['about-portrait', { monochrome: home.portraitStyle === 'monochrome' }]} src={url(home.portrait)} alt={home.portraitAlt} width="720" height="900" />}<div class="prose" set:html={renderMarkdown(about, import.meta.env.BASE_URL)} /></div> : <div class="empty-state compact-empty"><span class="empty-symbol" aria-hidden="true">✳</span></div>}</Shell>
