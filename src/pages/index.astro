---
import Shell from '../layouts/Shell.astro';
import EntryCard from '../components/EntryCard.astro';
import { home, site, writing, projects, selected, url } from '../lib/content';
import { heroHtml } from '../../shared/presentation.mjs';
const posts = selected(await writing(), home.featuredWriting);
const work = selected(await projects(), home.featuredProjects);
---
<Shell>
  <Fragment set:html={heroHtml(home, import.meta.env.BASE_URL)} />
  <div class="topic-rail"><span class="rail-label">Writing</span><div>{site.categories.map(category => <a href={`${url('writing/')}?category=${encodeURIComponent(category)}`}>{category}<span aria-hidden="true">↗</span></a>)}</div></div>
  <section class="home-writing"><div class="section-heading"><h2>{posts.length ? 'Selected writing' : 'Writing'}</h2><a class="text-link" href={url('writing/')}>View archive <span aria-hidden="true">↗</span></a></div>
    {posts.length ? <div class="entry-grid">{posts.map((entry, index) => <EntryCard entry={entry} index={index} />)}</div> : <div class="empty-rule"><span>No published articles selected.</span><span class="empty-symbol" aria-hidden="true">✳</span></div>}
  </section>
  {work.length > 0 && <section class="home-projects"><div class="section-heading"><h2>Selected projects</h2><a class="text-link" href={url('projects/')}>All projects ↗</a></div><div class="entry-grid">{work.map((entry, index) => <EntryCard entry={entry} kind="projects" index={index} />)}</div></section>}
</Shell>
