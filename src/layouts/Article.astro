---
import Shell from './Shell.astro';
import { url } from '../lib/content';
import { renderMarkdown, formatDate, readingTime } from '../../shared/markdown.mjs';
const { entry, kind = 'writing' } = Astro.props;
const data = entry.data;
---
<Shell title={data.title} description={data.description} image={data.coverImage} imageAlt={data.coverAlt} article={kind === 'writing'}>
  <article class="article-page"><header class="article-heading"><a class="back-link" href={url(`${kind}/`)}>← {kind === 'writing' ? 'Writing' : 'Projects'}</a><div class="eyebrow">{data.category}</div><h1>{data.title}</h1>{data.description && <p class="article-deck">{data.description}</p>}<div class="article-meta">{data.displayDate && <time datetime={data.displayDate}>{formatDate(data.displayDate)}</time>}{kind === 'writing' && <span>{readingTime(entry.body)} min read</span>}</div></header>
  {data.coverImage && <figure class="article-cover"><img src={url(data.coverImage)} alt={data.coverAlt} width="1600" height="1000" fetchpriority="high" /></figure>}
  <div class="prose" set:html={renderMarkdown(entry.body, import.meta.env.BASE_URL)} />
  {data.externalUrl && <div class="article-external"><a class="text-link" href={data.externalUrl} rel="noopener noreferrer">View project ↗</a></div>}
  {data.tags.length > 0 && <ul class="tag-list" aria-label="Tags">{data.tags.map(tag => <li>{tag}</li>)}</ul>}
  </article>
</Shell>
